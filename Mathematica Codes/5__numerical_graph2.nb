       "step"}], "-", "by", "-", "step"}], ",", 
    RowBox[{"providing", " ", "interpolating", " ", 
     RowBox[{"functions", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
