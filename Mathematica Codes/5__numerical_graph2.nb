 RowBox[{
  RowBox[{
   RowBox[{"I2Num", "=", "10.065"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Intermediate", " ", "Axis"}], "-", 
    RowBox[{
    "The", " ", "axis", " ", "where", " ", "the", " ", "flip", " ", 
     "occurs"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"I3Num", "=", "16.664"}], ";"}], "  ", 
  RowBox[{"(*", 
