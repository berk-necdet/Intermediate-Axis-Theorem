   "Evaluate", " ", "forces", " ", "the", " ", "plot", " ", "to", " ", "use", 
    " ", "the", " ", "solved", " ", "interpolating", " ", 
    RowBox[{"functions", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
