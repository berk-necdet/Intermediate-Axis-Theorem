    RowBox[{"output", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"numericalSolution", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "eq1Num", ",", "eq2Num", ",", "eq3Num", ",", "init1Num", ",", 
        "init2Num", ",", "init3Num"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"w1", ",", "w2", ",", "w3"}], "}"}], ",", 
      RowBox[{"{", 
