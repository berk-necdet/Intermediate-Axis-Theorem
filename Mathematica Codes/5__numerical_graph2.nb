  RowBox[{"(*", 
   RowBox[{"EXACT", " ", "NUMERIC", " ", "INITIAL", " ", "CONDITIONS", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Angular", " ", "Velocities", " ", "at", " ", "t"}], "=", "0"}],
      ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w1Num", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"w2Num", "=", "5.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"w3Num", "=", "0.1"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "EULER", " ", "EQUATIONS", " ", "WITH", " ", "NUMERICAL", " ", "VALUES"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq1Num", "=", 
   RowBox[{
    RowBox[{"I1Num", "*", 
     RowBox[{
      RowBox[{"w1", "'"}], "[", "t", "]"}]}], "==", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"I2Num", "-", "I3Num"}], ")"}], "*", 
     RowBox[{"w2", "[", "t", "]"}], "*", 
     RowBox[{"w3", "[", "t", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eq2Num", "=", 
   RowBox[{
    RowBox[{"I2Num", "*", 
     RowBox[{
      RowBox[{"w2", "'"}], "[", "t", "]"}]}], "==", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"I3Num", "-", "I1Num"}], ")"}], "*", 
     RowBox[{"w3", "[", "t", "]"}], "*", 
     RowBox[{"w1", "[", "t", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eq3Num", "=", 
    RowBox[{
